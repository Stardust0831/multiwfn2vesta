INPUT_PARAMETERS
suffix               abacus_h2o_scf
pseudo_dir           ../../../downloads/abacus_latest_molden/abacus-develop/tests/PP_ORB
orbital_dir          ../../../downloads/abacus_latest_molden/abacus-develop/tests/PP_ORB

calculation          scf
esolver_type         ksdft
basis_type           lcao
gamma_only           1
nbands               20
symmetry             -1
nspin                1

ecutwfc              60
scf_thr              1e-8
scf_nmax             150

smearing_method      gaussian
smearing_sigma       0.005
mixing_type          pulay
mixing_beta          0.35
mixing_gg0           0

out_chg              1
out_wfc_lcao         1
