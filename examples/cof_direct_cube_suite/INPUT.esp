INPUT_PARAMETERS
suffix               cof12000n2_esp
pseudo_dir           ../../../downloads/abacus_latest_molden/abacus-develop/tests/PP_ORB

calculation          scf
esolver_type         ksdft
basis_type           pw
gamma_only           1
symmetry             -1
nspin                1
nbands               160

ecutwfc              50
scf_thr              1e-7
scf_nmax             200

smearing_method      gaussian
smearing_sigma       0.005
mixing_type          pulay
mixing_beta          0.35
mixing_gg0           0

out_chg              1 8
out_pot              2 8
